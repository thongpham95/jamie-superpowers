#!/usr/bin/env python3
"""context-statusline - Claude Code statusLine command.

Reads the statusLine JSON on stdin and prints one line:
  <model> · <dir> · <git branch> · <context NN%>
The percentage is green below the yellow threshold, yellow below the red one, red above
(with " → /compact" appended). Defaults 50 / 70; override with
  jsp-pref set statusline.yellow 40      jsp-pref set statusline.red 60
Uses context_window.used_percentage; prints without it when absent. NO_COLOR disables colors.
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import jsplib as J  # noqa: E402


def num(v, default):
    try:
        return float(v)
    except (TypeError, ValueError):
        return default


def main(argv):
    if J.wants_help(argv):
        print(__doc__.strip())
        return 0
    try:
        data = json.loads(sys.stdin.read() or "{}")
    except ValueError:
        data = {}
    if not isinstance(data, dict):
        data = {}
    model = (data.get("model") or {}).get("display_name") or "Claude"
    cwd = (data.get("workspace") or {}).get("current_dir") or data.get("cwd") or os.getcwd()
    parts = [model, os.path.basename(cwd.rstrip("/")) or cwd]
    branch = J.git(cwd, "branch", "--show-current") or J.git(cwd, "rev-parse", "--short", "HEAD")
    if branch:
        parts.append(branch)

    pct = (data.get("context_window") or {}).get("used_percentage")
    if isinstance(pct, (int, float)):
        prefs = J.load_prefs().get("statusline") or {}
        yellow, red = num(prefs.get("yellow"), 50), num(prefs.get("red"), 70)
        color = "32" if pct < yellow else "33" if pct < red else "31"
        text = "%d%%" % round(pct)
        if "NO_COLOR" not in os.environ:
            text = "\033[%sm%s\033[0m" % (color, text)
        if pct >= red:
            text += " → /compact"
        parts.append(text)
    print(" · ".join(parts))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
